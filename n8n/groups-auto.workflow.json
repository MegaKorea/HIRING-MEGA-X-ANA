      "parameters": {
        "jsCode": "const items = $input.all().map(i => i.json);\nconst ok = items.filter(i => i.ok);\n\nreturn [{\n  json: {\n    success: ok.length === items.length,\n    run_id: items[0]?.run_id ?? null,\n    total: items.length,\n    posted: ok.length,\n    failed: items.length - ok.length,\n    finished_at: new Date().toISOString(),\n    results: items.map(({ content, ...rest }) => rest)\n  }\n}];"
