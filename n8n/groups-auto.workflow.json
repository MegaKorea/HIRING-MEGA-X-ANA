    {
      "parameters": {
        "jsCode": "const p = $('Prepare Payload').first().json;\n\nfunction shuffle(arr) {\n  const a = [...arr];\n  for (let i = a.length - 1; i > 0; i--) {\n    const j = Math.floor(Math.random() * (i + 1));\n    [a[i], a[j]] = [a[j], a[i]];\n  }\n  return a;\n}\n\n// Boc khong hoan lai: het pool moi tron lai -> moi content duoc dung chenh nhau toi da 1 lan,\n// khong don nhieu nhom lien tiep vao cung 1 bai (Facebook gan co spam).\n// Logic mirror tai n8n/assign-contents.mjs (chay: node n8n/assign-contents.mjs).\nlet bag = [];\n\nreturn p.group_ids.map((gid, i) => {\n  if (bag.length === 0) bag = shuffle(p.contents);\n  const pick = bag.pop();\n  return {\n    json: {\n      index: i + 1,\n      total: p.group_ids.length,\n      run_id: p.run_id,\n      category: p.category,\n      page_id: p.page_id,\n      group_id: String(gid),\n      template_id: pick.template_id,\n      content: pick.content,\n      image_url: pick.image_url\n    }\n  };\n});"
      },
