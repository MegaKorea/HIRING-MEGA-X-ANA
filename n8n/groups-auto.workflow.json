      "parameters": {
        "jsCode": "const src = $('Loop Over Groups').first().json;\nconst res = $json || {};\n\nconst postId = res.post_id ?? res.story_fbid ?? res.id ?? null;\nconst errMsg = res.error?.message ?? res.error ?? res.message ?? null;\n\n// Ten field duoi day trung ten cot cua public.post_log -> node Supabase auto-map duoc.\nreturn [{\n  json: {\n    run_id: src.run_id,\n    category: src.category,\n    page_id: src.page_id,\n    group_id: src.group_id,\n    template_id: src.template_id ?? null,\n    content: src.content,\n    image_url: src.image_url || '',\n    post_id: postId ? String(postId) : null,\n    ok: Boolean(postId),\n    error: postId ? null : (errMsg ? String(errMsg) : 'No post ID returned')\n  }\n}];"
