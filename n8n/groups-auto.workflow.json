        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({ success: true, accepted: true, message: 'Job accepted, posting in background', run_id: $json.run_id, page_id: $json.page_id, total_groups: $json.group_ids.length, total_contents: $json.contents.length, random_content: $json.contents.length > 1, accepted_at: new Date().toISOString() }) }}",
        "options": {}
