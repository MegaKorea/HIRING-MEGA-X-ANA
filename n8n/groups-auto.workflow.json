    {
      "parameters": {
        "jsCode": "const raw = $input.first().json;\nconst body = raw.body ?? raw;\n\nif (body.type !== 'group_post') {\n  throw new Error('type must be \"group_post\", received: ' + body.type);\n}\n\n// App gui contents[]: 1 phan tu = content co dinh, nhieu phan tu = random theo tung nhom.\n// Fallback body.content de payload cu van chay.\nconst rawContents = Array.isArray(body.contents) && body.contents.length\n  ? body.contents\n  : [{ template_id: null, content: body.content, image_url: body.image_url }];\n\nconst contents = rawContents\n  .map(c => ({\n    template_id: c.template_id ?? null,\n    content: String(c.content ?? '').trim(),\n    image_url: c.image_url ? String(c.image_url).trim() : ''\n  }))\n  .filter(c => c.content);\n\nif (contents.length === 0) {\n  throw new Error('contents is empty - khong co content nao de dang');\n}\n\nconst groupIds = Array.isArray(body.group_ids)\n  ? [...new Set(body.group_ids.map(String).map(s => s.trim()).filter(Boolean))]\n  : [];\n\nif (groupIds.length === 0) {\n  throw new Error('group_ids is empty or not an array');\n}\n\n// Default Page ID, or send page_id in the payload\nconst DEFAULT_PAGE_ID = '1095167380349359';\nconst pageId = String(body.page_id || DEFAULT_PAGE_ID).trim();\nif (!pageId) {\n  throw new Error('Missing page_id (posting as a Page requires a Page ID)');\n}\n\nreturn [{\n  json: {\n    run_id: String(body.run_id || $execution.id),\n    category: body.category ?? '',\n    page_id: pageId,\n    group_ids: groupIds,\n    contents\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -1984,
